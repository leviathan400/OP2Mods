#include <windows.h>
#include "..\launcher\version.h"  // MODVER_MAJOR/MINOR/PATCH - shared with Launcher.dll

#define VER_STR2(x) #x
#define VER_STR(x)  VER_STR2(x)
#define VER_STRING  VER_STR(MODVER_MAJOR) "." VER_STR(MODVER_MINOR) "." VER_STR(MODVER_PATCH)

// Application icon (ConVec) - shown in Explorer / the taskbar.
1 ICON "ConVec.ico"

// Version / properties metadata (Details tab in file Properties).
1 VERSIONINFO
FILEVERSION    MODVER_MAJOR,MODVER_MINOR,MODVER_PATCH,0
PRODUCTVERSION MODVER_MAJOR,MODVER_MINOR,MODVER_PATCH,0
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Outpost Universe"
            VALUE "LegalCopyright",   "Outpost Universe"
            VALUE "FileDescription",  "OP2Launcher"
            VALUE "ProductName",      "OP2Launcher"
            VALUE "FileVersion",      VER_STRING
            VALUE "ProductVersion",   VER_STRING
            VALUE "OriginalFilename", "op2launcher.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
